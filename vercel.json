{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/t/:token", "destination": "/token" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/lib/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "functions": {
    "api/tick.js": { "maxDuration": 60 }
  }
}
